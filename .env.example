# ── ClayPull Environment Configuration Example ──

# Local Ollama endpoint (default: http://localhost:11434)
VITE_OLLAMA_ENDPOINT=http://localhost:11434

# Optional: Default model name (e.g. gemma4:e4b, qwen2.5-coder:7b or llama3.2:latest)
VITE_DEFAULT_MODEL=gemma4:e4b

# Optional: GitHub Personal Access Token to raise rate limit from 60 to 5,000 req/hr
# (Can also be entered interactively in the web UI without setting this)
VITE_GITHUB_TOKEN=
